# ============================================================================
# KIMI_TRUTH — tool documentation (estate .env doc form)
# Tool:    C++26 seal verification that cannot be fooled by line endings
# Author:  Kimi K3 (BettyBot session, 12/09/2026), owner D. Hargreaves
# Law:     Living Book docs/00_law (SEAL · TAG · CODEGEN · CONSUME) ·
#          Ratification Tamper-Evidence Policy ("if the hash drifted, the
#          plan is not ratified") · MEMO L-021 (dual-lane QC)
# ============================================================================

KIMI_TRUTH_NAME="kimi_truth"
KIMI_TRUTH_VERSION="1.0.0"
KIMI_TRUTH_DATE="12/09/2026"

# --- Locations (one spelling per lane, never crossed) -----------------------
KIMI_TRUTH_HOME_WIN="C:\McMaker Projects\Projects\AvalonOS\inc\Repos\Kimi-Truth"
KIMI_TRUTH_HOME_GITBASH="/c/McMaker Projects/Projects/AvalonOS/inc/Repos/Kimi-Truth"
KIMI_TRUTH_HOME_WSL="/mnt/c/McMaker Projects/Projects/AvalonOS/inc/Repos/Kimi-Truth"
KIMI_TRUTH_BIN_WIN="C:\McMaker Projects\Projects\AvalonOS\inc\Repos\Kimi-Truth\kimi_truth.exe"
KIMI_TRUTH_BIN_WSL="/mnt/c/McMaker Projects/Projects/AvalonOS/inc/Repos/Kimi-Truth/kimi_truth"

# --- What it fixes ----------------------------------------------------------
# BettyBot, 12/09/2026: four ratified work orders "failed" their BLAKE3
# seals. Two were CRLF drift only (content byte-identical after LF
# normalisation). Two had genuinely drifted — content edited after sealing
# with no new seal line (BB-WO-005_LONG_HORIZON.md,
# BB-WO-006_PUBLIC_CHAT_SURFACE.md — see BettyBot docs/02_ratification).
# A bare byte-hash cannot tell tamper from line-ending noise. kimi_truth can.
KIMI_TRUTH_FAILURE_CLASS="tamper-vs-line-ending-drift disambiguation"

# --- Canonical rule ---------------------------------------------------------
# Seals are computed over LF-normalised content (every CR stripped), so a
# file keeps its seal across Windows (CRLF) and Linux (LF) checkouts.
KIMI_TRUTH_SEAL_BASIS="LF-canonical"

# --- Crypto -----------------------------------------------------------------
# LFSSL BLAKE3 only — consumed, never mirrored
# (C:\McMaker Projects\Projects\LFSSL - Lamia Fabrica SSL).
# Boot gate: the official BLAKE3 empty-message KAT
# (af1349b9...f3262) must pass or every verdict refuses (fail closed).
KIMI_TRUTH_HASH="LFSSL::Crypto::BLAKE3::Hasher::hash_32"
KIMI_TRUTH_KAT_EMPTY="af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262"

# --- Usage ------------------------------------------------------------------
#   kimi_truth selftest                official BLAKE3 KAT gate (fail closed)
#   kimi_truth hash <file>             print RAW and LF-canonical digests
#   kimi_truth verify <file> [seal]    verdict vs <seal> (default <file>.seal)
#   kimi_truth seal <file>             append dated LF hash to <file>.seal
KIMI_TRUTH_USAGE="selftest|hash <file>|verify <file> [seal]|seal <file>"

# --- Verdicts ---------------------------------------------------------------
#   MATCH_RAW  bytes identical to the sealed hash            (exit 0)
#   MATCH_LF   line-ending drift only — content intact       (exit 0)
#   DRIFT      content changed since seal — unratified       (exit 1)
#   usage/IO error                                           (exit 2)
KIMI_TRUTH_EXIT_MATCH="0"
KIMI_TRUTH_EXIT_DRIFT="1"
KIMI_TRUTH_EXIT_ERROR="2"

# --- Build (dual-lane, both -Werror clean) -----------------------------------
# Windows (WinLibs g++ 16.2.0):
#   g++ -std=c++26 -Wall -Wextra -Wpedantic -Werror ^
#     -I "C:/McMaker Projects/Projects/AvalonOS/inc/Repos/LFSSL/include" ^
#     -I . kimi_truth.cpp ^
#     "C:/McMaker Projects/Projects/AvalonOS/inc/Repos/LFSSL/build_win_gcc162/lib/liblfssl.dll.a" ^
#     -o kimi_truth.exe
#   (runtime: liblfssl.dll from .../LFSSL/build_win_gcc162/bin on PATH)
# WSL (Ubuntu-26.04, g++-16 — the MEMO L-021 binding lane):
#   g++-16 -std=c++26 -Wall -Wextra -Wpedantic -Werror \
#     -I "/mnt/c/McMaker Projects/Projects/AvalonOS/inc/Repos/LFSSL/include" -I . kimi_truth.cpp \
#     "/mnt/c/McMaker Projects/Projects/AvalonOS/inc/Repos/LFSSL/build_wsl_gcc162/lib/liblfssl.so.1.0.0" \
#     -Wl,-rpath,/mnt/c/McMaker\ Projects/Projects/AvalonOS/inc/Repos/LFSSL/build_wsl_gcc162/lib \
#     -o kimi_truth
# CMakeLists.txt in the same folder wires the same for the estate build.

# --- Acceptance battery (ran green both lanes 12/09/2026) --------------------
#   BRAIN_LOCKDOWN_LEDGER.tsv     MATCH_RAW  (seal chain intact)
#   BB-WO-004_S0_MAP.md           MATCH_LF   (CRLF drift only)
#   BB-WO-004_WORK_ORDER.md       MATCH_LF   (CRLF drift only)
#   BB-WO-005_LONG_HORIZON.md     DRIFT      (genuine post-seal content edit)
#   BB-WO-006_PUBLIC_CHAT_SURFACE DRIFT      (genuine post-seal content edit)
# Verdicts byte-identical on Windows and WSL lanes.
KIMI_TRUTH_BATTERY="5/5 known-truth cases, dual-lane identical"

# --- House rules -------------------------------------------------------------
# en-GB prose. Zulu timestamps in seal lines. No stubs, no banned vocabulary.
# A DRIFT verdict is evidence, not an accusation: it means "re-ratify before
# you trust this document" — the cure is a new dated seal line, never an edit
# of the old one (seal logs are append-only).
